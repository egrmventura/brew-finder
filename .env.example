# Environment for local development. Copy to .env and fill in; .env is gitignored.
# See README.md, Quick start.
#
# The values below are local-development defaults that match docker-compose.yml.
# They are not secrets and must not be reused on any reachable host.

# Docker Compose (`pnpm db:up`) creates the database from these on first start.
# `pnpm db:migrate` and dbt connect with them too, to 127.0.0.1:POSTGRES_PORT,
# unless DATABASE_URL is set. If another Postgres already listens on 5432,
# changing POSTGRES_PORT is enough.
#
# USER, PASSWORD and DB take effect only when the data volume is first created.
# Changing them later breaks every connection until the volume is recreated:
# `docker compose down -v` (this deletes the local database), then `pnpm db:up`.
# Use letters, digits, and - _ . only: Compose and Node read $, # and quotes in
# .env differently, and db:migrate refuses them.
POSTGRES_USER=beerfinder
POSTGRES_PASSWORD=beerfinder
POSTGRES_DB=beerfinder
POSTGRES_PORT=5432

# Only for a PostgreSQL 18 (with PostGIS and pg_trgm) not run by docker compose.
# When set, it replaces the POSTGRES_* values above for db:migrate and dbt.
# DATABASE_URL=

# Password for beerfinder_readonly, the SELECT-only role created by `pnpm db:migrate`,
# for review sessions and future MCP use. Set on every db:migrate run.
BEERFINDER_READONLY_PASSWORD=beerfinder_readonly
