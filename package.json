{
  "name": "beerfinder",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=12"
  },
  "scripts": {
    "test": "node scripts/require-workspace-script.mjs test && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:docs": "markdownlint-cli2",
    "dev": "pnpm -r --parallel dev",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file-if-exists=.env scripts/db/migrate.mjs",
    "db:seed": "echo 'db:seed not implemented — Phase 1, see PLAN.md §7' && exit 1",
    "dbt:run": "node --env-file-if-exists=.env scripts/dbt.mjs run",
    "dbt:test": "node --env-file-if-exists=.env scripts/dbt.mjs test"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "pg": "8.23.0"
  }
}
